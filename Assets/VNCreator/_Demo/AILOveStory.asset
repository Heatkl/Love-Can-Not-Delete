    backgroundMusic: {fileID: 0}
  - guid: 3f0746da-c40b-40cb-bfef-95d3650cd804
    characterSpr: {fileID: 0}
    characterName: 
    dialogueText: "\u0414\u0430, \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0447\u0442\u043E \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442 \u0432\u0430\u0436\u0435\u043D
      \u0434\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0441 \u043B\u044E\u0434\u044C\u043C\u0438. \u041A\u0430\u043A \u044F \u043C\u043E\u0433\u0443
      \u043F\u043E\u043C\u043E\u0447\u044C \u0432 \u044D\u0442\u043E\u043C \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435?\r\n\r\n"
    backgroundSpr: {fileID: 0}
    startNode: 0
    endNode: 0
    choices: 1
