  - guid: cfe25e6b-3c07-4716-b1e2-e77f81ab3b2f
    characterSpr: {fileID: 21300000, guid: 7704557481c43e34ea43ece92414a844, type: 3}
    characterName: "\u0414\u0436\u043E\u0437\u0435\u0444 \u0413\u043E\u043B\u0434\u043C\u0430\u043D"
    dialogueText: "\u041F\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C,
      \u0410\u043B\u0435\u043A\u0441. \u0412\u044B \u043F\u043E\u043C\u043D\u0438\u0442\u0435
      \u043E \u0437\u0430\u0434\u0430\u043D\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438
