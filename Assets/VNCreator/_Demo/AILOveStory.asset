    characterSpr: {fileID: 21300000, guid: a99bce0e596e9eb4e933b8f8fdb86a2c, type: 3}
    characterName: "\u0410\u043B\u0435\u043A\u0441"
    dialogueText: "\u0410\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u044B
