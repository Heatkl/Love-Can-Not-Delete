  - guid: 8cae9977-f73f-4967-82cc-3391916ed762
    characterSpr: {fileID: 0}
    characterName: "\u0412\u0430\u0439\u043E\u043B\u0435\u0442"
    dialogueText: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0410\u043B\u0435\u043A\u0441.
      \u0410 \u043A\u0430\u043A \u0437\u043E\u0432\u0443\u0442 \u043C\u0435\u043D\u044F?"
    backgroundSpr: {fileID: 0}
    startNode: 0
    endNode: 0
    choices: 2
    choiceOptions:
    - "\u0414\u0443\u043C\u0430\u044E, \u0412\u0438 \u0442\u0435\u0431\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442. "
    - "\u041C\u043D\u0435 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E, \u0432\u044B\u0431\u0435\u0440\u0438
