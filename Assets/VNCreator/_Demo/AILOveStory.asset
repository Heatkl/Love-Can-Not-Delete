  - guid: 4a812dea-1048-47a1-ac0e-a4e6afcab11e
    characterSpr: {fileID: 21300000, guid: a99bce0e596e9eb4e933b8f8fdb86a2c, type: 3}
    characterName: "\u0410\u043B\u0435\u043A\u0441"
    dialogueText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u044B \u043D\u0430\u0447\u043D\u0435\u043C
      \u0442\u0432\u043E\u0435 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u044D\u043C\u043E\u0446\u0438\u044F\u043C,
      \u0412\u0438. \u0422\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u043E?\r\n"
    backgroundSpr: {fileID: 0}
    startNode: 0
    endNode: 0
    choices: 1
