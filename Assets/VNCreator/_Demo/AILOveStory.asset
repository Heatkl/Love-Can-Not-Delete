  - guid: 57bfc8af-d0d5-441d-944e-c56d3395376c
    characterSpr: {fileID: 0}
    characterName: "\u0412\u0430\u0439\u043E\u043B\u0435\u0442"
    dialogueText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u043A\u0430\u043A \u044F \u043C\u043E\u0433\u0443 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
