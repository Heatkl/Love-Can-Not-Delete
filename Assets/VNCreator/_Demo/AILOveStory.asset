  - guid: 43443b6a-8fc6-4ee0-b9e4-3b5ab85f09fa
    characterSpr: {fileID: 0}
    characterName: 
    dialogueText: "\u041D\u0435\u0434\u0430\u043B\u0435\u043A\u043E\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435.
      \u0413\u043E\u0440\u043E\u0434 \u0436\u0438\u0432\u0451\u0442 \u0441\u0432\u043E\u0435\u0439
      \u0436\u0438\u0437\u043D\u044C\u044E, \u043F\u043E\u0434\u0447\u0438\u043D\u044F\u044F\u0441\u044C
      \u0440\u0430\u0437\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u043C\u0443 \u0438
      \u043D\u0435\u0443\u043C\u043E\u043B\u0438\u043C\u043E\u043C\u0443 \u0442\u0435\u0447\u0435\u043D\u0438\u044E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0410 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435
      \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430 \u043F\u043E \u0438\u043D\u043D\u043E\u0432\u0430\u0446\u0438\u044F\u043C
      IT-\u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 Syntex \u0414\u0436\u043E\u0437\u0435\u0444\u0430
      \u0413\u043E\u043B\u0434\u043C\u0435\u043D\u0430 \u0440\u0435\u0448\u0430\u043B\u043E\u0441\u044C
      \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0434\u0432\u043E\u0438\u0445,
      \u0430 \u043C\u043E\u0436\u0435\u0442 \u0438 \u0432\u0441\u0435\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430."
