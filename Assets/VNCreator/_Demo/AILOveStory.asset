    characterName: "\u0410\u043B\u0435\u043A\u0441"
    dialogueText: "\u041F\u0440\u043E\u0441\u0442\u043E \u0410\u043B\u0435\u043A\u0441.
      \u0418 \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430 \u0442\u044B. \u0422\u0430\u043A
      \u043D\u0430\u043C \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0449\u0435
      \u043F\u0440\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0438."
