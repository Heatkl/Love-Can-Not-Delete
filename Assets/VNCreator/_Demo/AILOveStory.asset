  - guid: 71c7307d-a03c-48d1-8f37-156bc5b1edbe
    characterSpr: {fileID: 21300000, guid: a99bce0e596e9eb4e933b8f8fdb86a2c, type: 3}
    characterName: "\u0410\u043B\u0435\u043A\u0441"
    dialogueText: "\u0414\u0430, \u043C\u0438\u0441\u0442\u0435\u0440 \u0413\u043E\u043B\u0434\u043C\u0435\u043D.
      \u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0442\u0435\u0441\u0442\u044B
      \u0441 \u043D\u0430\u0448\u0438\u043C \u043D\u043E\u0432\u044B\u043C \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0431\u0438\u043E\u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u043E\u043C."
    backgroundSpr: {fileID: 21300000, guid: dca3233597955274fb287647dd0be2d5, type: 3}
    startNode: 0
    endNode: 0
    choices: 1
    choiceOptions:
    - 
